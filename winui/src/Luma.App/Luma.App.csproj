<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Luma.Preview</RootNamespace>
    <AssemblyName>Luma</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../../public/luma.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Version>1.2.0</Version>
    <LumaMigrationStage>8</LumaMigrationStage>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <Product>Luma</Product>
    <Description>Native image and model manager.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Luma.Core/Luma.Core.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <Content Include="../../../public/luma.ico" Link="Assets/Luma.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Unpackaged SDK publish omits generated application XBF/PRI resources.
       Keep this explicit until the upstream MRTCore publish wiring is fixed. -->
  <Target Name="PublishLumaXamlResources" AfterTargets="Publish">
    <ItemGroup>
      <LumaXamlResource Include="$(TargetDir)**/*.xbf" />
    </ItemGroup>
    <Error Condition="!Exists('%(LumaXamlResource.Identity)')" Text="Missing compiled Luma XAML resource: %(LumaXamlResource.Identity)" />
    <Error Condition="!Exists('$(TargetDir)$(AssemblyName).pri')" Text="Missing Luma application PRI" />
    <Copy SourceFiles="@(LumaXamlResource)" DestinationFiles="@(LumaXamlResource->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pri" DestinationFolder="$(PublishDir)" />
  </Target>
</Project>
