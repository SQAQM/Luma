<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="using:Microsoft.UI.Xaml.Controls.Primitives" xmlns:fx="using:Luma.Preview.Services">
 <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
 <CornerRadius x:Key="GridViewItemCheckBoxCornerRadius">6</CornerRadius>
 <CornerRadius x:Key="ListViewItemCheckBoxCornerRadius">6</CornerRadius>
 <ControlTemplate x:Key="LumaGlassTemplate" TargetType="p:ButtonBase">
  <Grid x:Name="GlassRoot" Background="Transparent">
   <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"><VisualState.Setters><Setter Target="HoverWash.Opacity" Value="0"/><Setter Target="PressWash.Opacity" Value="0"/><Setter Target="CheckedWash.Opacity" Value="0"/></VisualState.Setters></VisualState><VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="HoverWash.Opacity" Value="1"/><Setter Target="PressWash.Opacity" Value="0"/><Setter Target="CheckedWash.Opacity" Value="0"/></VisualState.Setters></VisualState><VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="HoverWash.Opacity" Value="0"/><Setter Target="PressWash.Opacity" Value="1"/><Setter Target="CheckedWash.Opacity" Value="0"/></VisualState.Setters></VisualState><VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="HoverWash.Opacity" Value="0"/><Setter Target="PressWash.Opacity" Value="0"/><Setter Target="CheckedWash.Opacity" Value="0"/><Setter Target="ButtonContent.Foreground" Value="{ThemeResource LumaGlassDisabledText}"/><Setter Target="GlassShine.Opacity" Value="0.15"/></VisualState.Setters></VisualState><VisualState x:Name="Checked"><VisualState.Setters><Setter Target="HoverWash.Opacity" Value="0"/><Setter Target="PressWash.Opacity" Value="0"/><Setter Target="CheckedWash.Opacity" Value="1"/></VisualState.Setters></VisualState><VisualState x:Name="CheckedPointerOver"><VisualState.Setters><Setter Target="HoverWash.Opacity" Value="1"/><Setter Target="PressWash.Opacity" Value="0"/><Setter Target="CheckedWash.Opacity" Value="1"/></VisualState.Setters></VisualState><VisualState x:Name="CheckedPressed"><VisualState.Setters><Setter Target="HoverWash.Opacity" Value="0"/><Setter Target="PressWash.Opacity" Value="1"/><Setter Target="CheckedWash.Opacity" Value="1"/></VisualState.Setters></VisualState><VisualState x:Name="CheckedDisabled"><VisualState.Setters><Setter Target="HoverWash.Opacity" Value="0"/><Setter Target="PressWash.Opacity" Value="0"/><Setter Target="CheckedWash.Opacity" Value="0.5"/><Setter Target="ButtonContent.Foreground" Value="{ThemeResource LumaGlassDisabledText}"/><Setter Target="GlassShine.Opacity" Value="0.15"/></VisualState.Setters></VisualState><VisualState x:Name="Indeterminate"><VisualState.Setters><Setter Target="HoverWash.Opacity" Value="0"/><Setter Target="PressWash.Opacity" Value="0"/><Setter Target="CheckedWash.Opacity" Value="0.6"/></VisualState.Setters></VisualState><VisualState x:Name="IndeterminatePointerOver"><VisualState.Setters><Setter Target="HoverWash.Opacity" Value="1"/><Setter Target="PressWash.Opacity" Value="0"/><Setter Target="CheckedWash.Opacity" Value="0.6"/></VisualState.Setters></VisualState><VisualState x:Name="IndeterminatePressed"><VisualState.Setters><Setter Target="HoverWash.Opacity" Value="0"/><Setter Target="PressWash.Opacity" Value="1"/><Setter Target="CheckedWash.Opacity" Value="0.6"/></VisualState.Setters></VisualState><VisualState x:Name="IndeterminateDisabled"><VisualState.Setters><Setter Target="HoverWash.Opacity" Value="0"/><Setter Target="PressWash.Opacity" Value="0"/><Setter Target="CheckedWash.Opacity" Value="0.3"/><Setter Target="ButtonContent.Foreground" Value="{ThemeResource LumaGlassDisabledText}"/><Setter Target="GlassShine.Opacity" Value="0.15"/></VisualState.Setters></VisualState></VisualStateGroup>
    <VisualStateGroup x:Name="FocusStates"><VisualState x:Name="Unfocused"/><VisualState x:Name="PointerFocused"/><VisualState x:Name="Focused"><VisualState.Setters><Setter Target="FocusRing.Opacity" Value="1"/></VisualState.Setters></VisualState></VisualStateGroup>
   </VisualStateManager.VisualStateGroups>
   <Border x:Name="GlassBody" CornerRadius="{TemplateBinding CornerRadius}" Background="{ThemeResource LumaGlassBase}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"></Border>
   <Border CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}" IsHitTestVisible="False"/>
   <Border x:Name="GlassShine" CornerRadius="{TemplateBinding CornerRadius}" Background="{ThemeResource LumaGlassSpecular}" IsHitTestVisible="False"/>
   <Border CornerRadius="{TemplateBinding CornerRadius}" Background="{ThemeResource LumaGlassUnderEdge}" IsHitTestVisible="False"/>
   <Border x:Name="CheckedWash" CornerRadius="{TemplateBinding CornerRadius}" Background="{ThemeResource LumaGlassSelected}" Opacity="0" IsHitTestVisible="False"/>
   <Border x:Name="HoverWash" CornerRadius="{TemplateBinding CornerRadius}" Background="{ThemeResource LumaGlassHover}" Opacity="0" IsHitTestVisible="False"/>
   <Border x:Name="PressWash" CornerRadius="{TemplateBinding CornerRadius}" Background="{ThemeResource LumaGlassPressed}" Opacity="0" IsHitTestVisible="False"/>
   <Border CornerRadius="{TemplateBinding CornerRadius}" BorderBrush="{ThemeResource LumaGlassRim}" BorderThickness="1" IsHitTestVisible="False"/>
   <Border Margin="1" CornerRadius="{TemplateBinding CornerRadius}" BorderBrush="{ThemeResource LumaGlassInnerRim}" BorderThickness="0.7" IsHitTestVisible="False"/>
   <ContentPresenter x:Name="ButtonContent" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentTransitions="{TemplateBinding ContentTransitions}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}"/>
   <Border x:Name="FocusRing" CornerRadius="{TemplateBinding CornerRadius}" BorderBrush="{ThemeResource LumaGlassFocus}" BorderThickness="2" Margin="-3" Opacity="0" IsHitTestVisible="False"/>
  </Grid>
 </ControlTemplate>
 <Style x:Key="LumaButton" TargetType="Button"><Setter Property="Template" Value="{StaticResource LumaGlassTemplate}"/><Setter Property="fx:GlassButtonEffects.Enabled" Value="True"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="16,7"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Foreground" Value="{ThemeResource LumaText}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{ThemeResource LumaStroke}"/><Setter Property="BorderThickness" Value="0.5"/><Setter Property="UseSystemFocusVisuals" Value="False"/></Style>
 <Style TargetType="Button" BasedOn="{StaticResource LumaButton}"/>
 <Style x:Key="LumaNav" TargetType="Button" BasedOn="{StaticResource LumaButton}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="12,7"/><Setter Property="CornerRadius" Value="8"/><Setter Property="BorderThickness" Value="0.5"/></Style>
 <Style x:Key="LumaChip" TargetType="Button" BasedOn="{StaticResource LumaButton}"><Setter Property="CornerRadius" Value="8"/><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="10,4"/><Setter Property="Foreground" Value="{ThemeResource LumaAccent}"/></Style>
 <Style x:Key="LumaViewerIcon" TargetType="Button" BasedOn="{StaticResource LumaButton}"><Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="MinWidth" Value="36"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="9"/></Style>
 <Style TargetType="ContentDialog"><Setter Property="PrimaryButtonStyle" Value="{StaticResource LumaButton}"/><Setter Property="SecondaryButtonStyle" Value="{StaticResource LumaButton}"/><Setter Property="CloseButtonStyle" Value="{StaticResource LumaButton}"/></Style>
 <Style TargetType="TextBox"><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="12,6"/><Setter Property="Background" Value="{ThemeResource LumaSurface}"/><Setter Property="Foreground" Value="{ThemeResource LumaText}"/><Setter Property="PlaceholderForeground" Value="{ThemeResource LumaSecondary}"/><Setter Property="BorderBrush" Value="{ThemeResource LumaStroke}"/><Setter Property="BorderThickness" Value="0.5"/><Setter Property="CornerRadius" Value="12"/></Style>
 <Style TargetType="PasswordBox"><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="12,6"/><Setter Property="Background" Value="{ThemeResource LumaSurface}"/><Setter Property="Foreground" Value="{ThemeResource LumaText}"/><Setter Property="BorderBrush" Value="{ThemeResource LumaStroke}"/><Setter Property="BorderThickness" Value="0.5"/><Setter Property="CornerRadius" Value="12"/></Style>
 <Style TargetType="NumberBox"><Setter Property="MinHeight" Value="36"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Foreground" Value="{ThemeResource LumaText}"/><Setter Property="Background" Value="{ThemeResource LumaSurface}"/></Style>
 <Style TargetType="ComboBox"><Setter Property="Background" Value="{ThemeResource LumaSurface}"/><Setter Property="Foreground" Value="{ThemeResource LumaText}"/><Setter Property="BorderBrush" Value="{ThemeResource LumaStroke}"/><Setter Property="CornerRadius" Value="8"/></Style>
 <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{ThemeResource LumaText}"/><Setter Property="CornerRadius" Value="6"/></Style>
 <Style x:Key="LumaReactionSymbol" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Symbol"/><Setter Property="FontSize" Value="19"/><Setter Property="Foreground" Value="{ThemeResource LumaSecondary}"/></Style>
 <Style x:Key="LumaHeartSymbol" TargetType="TextBlock" BasedOn="{StaticResource LumaReactionSymbol}"><Setter Property="Foreground" Value="{ThemeResource LumaHeart}"/></Style>
 <Style x:Key="LumaStarSymbol" TargetType="TextBlock" BasedOn="{StaticResource LumaReactionSymbol}"><Setter Property="Foreground" Value="{ThemeResource LumaStar}"/></Style>
 <Style x:Key="LumaReaction" TargetType="Button">
  <Setter Property="Width" Value="24"/><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="UseSystemFocusVisuals" Value="True"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ReactionSurface" CornerRadius="5" Background="Transparent"><VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="ReactionSurface.Background" Value="{ThemeResource LumaGlassHover}"/></VisualState.Setters></VisualState><VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="ReactionSurface.Background" Value="{ThemeResource LumaGlassPressed}"/></VisualState.Setters></VisualState><VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="ReactionSurface.Opacity" Value="0.5"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups><ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="p:ScrollBar"><Setter Property="CornerRadius" Value="3"/></Style>
</ResourceDictionary>
