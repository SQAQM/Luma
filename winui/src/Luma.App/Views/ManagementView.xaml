<UserControl x:Class="Luma.Preview.Views.ManagementView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Luma.Preview.Views.Controls">
 <UserControl.Resources>
  <Style x:Key="ModelFilterChip" TargetType="ToggleButton"><Setter Property="Template" Value="{StaticResource LumaGlassTemplate}"/><Setter Property="Padding" Value="10,4"/><Setter Property="MinHeight" Value="30"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Foreground" Value="{ThemeResource LumaText}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{ThemeResource LumaStroke}"/><Setter Property="BorderThickness" Value="0.5"/><Setter Property="UseSystemFocusVisuals" Value="False"/></Style>
  <DataTemplate x:Key="LinkedTemplate"><StackPanel Width="132" Spacing="4"><Image Source="{Binding Image}" Height="{Binding ImageHeight}" Stretch="Uniform"/><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="{Binding LabelSize}"/></StackPanel></DataTemplate>
  <DataTemplate x:Key="DescriptionTemplate"><TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></DataTemplate>
  <DataTemplate x:Key="RecordTemplate"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Label}" Margin="4,8" FontSize="{Binding FontSize}"/></DataTemplate>
  <DataTemplate x:Key="ModelTemplate">
   <Grid Padding="5" RowSpacing="6" ToolTipService.ToolTip="{Binding Label}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Height="{Binding CoverHeight}" CornerRadius="8" Background="{ThemeResource LumaGlassBase}" BorderBrush="{ThemeResource LumaStroke}" BorderThickness="0.5">
     <Grid>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" Visibility="{Binding CoverPlaceholder}"><Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"><ContentPresenter Content="Icon" ContentTemplate="{StaticResource LumaIconGallery}" Style="{StaticResource LumaLineIcon}" Foreground="{ThemeResource LumaSecondary}"/></Viewbox><TextBlock Text="{Binding CoverStatus}" Style="{StaticResource LumaCaption}" FontSize="{Binding CaptionSize}"/></StackPanel>
      <Image Source="{Binding Cover}" Stretch="Uniform"/>
      <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="5" Padding="6,2" CornerRadius="4" Background="{ThemeResource LumaSurface}" Visibility="{Binding CardCategory}">
       <TextBlock Text="{Binding Meta}" FontSize="{Binding CaptionSize}" Style="{StaticResource LumaCaption}" TextTrimming="CharacterEllipsis"/>
      </Border>
     </Grid>
    </Border>
    <TextBlock Grid.Row="1" Text="{Binding CardTitle}" FontSize="{Binding FontSize}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
   </Grid>
  </DataTemplate>
  <DataTemplate x:Key="CompactModelTemplate">
   <Grid Padding="5" ColumnSpacing="10" ToolTipService.ToolTip="{Binding Label}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Height="58" CornerRadius="7" Background="{ThemeResource LumaGlassBase}" BorderBrush="{ThemeResource LumaStroke}" BorderThickness="0.5" ToolTipService.ToolTip="{Binding CoverStatus}">
     <Grid><Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding CoverPlaceholder}"><ContentPresenter Content="Icon" ContentTemplate="{StaticResource LumaIconGallery}" Style="{StaticResource LumaLineIcon}" Foreground="{ThemeResource LumaSecondary}"/></Viewbox><Image Source="{Binding Cover}" Stretch="Uniform"/></Grid>
    </Border>
    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
     <TextBlock Text="{Binding CardTitle}" FontSize="{Binding FontSize}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
     <TextBlock Text="{Binding Meta}" FontSize="{Binding CaptionSize}" Style="{StaticResource LumaCaption}" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
   </Grid>
  </DataTemplate>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <controls:TagChipPanel x:Name="Actions" Margin="0,0,0,10"/>
  <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,10">
   <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ScopeText" Style="{StaticResource LumaCaption}" VerticalAlignment="Center" TextWrapping="Wrap"/><TextBlock x:Name="ReadIndicator" Grid.Column="1" Text="读取中…" Style="{StaticResource LumaCaption}" VerticalAlignment="Center" Opacity="0" MinWidth="54" AutomationProperties.AutomationId="ManageReading"/><StackPanel x:Name="ModelPager" Orientation="Horizontal" Spacing="8" Grid.Column="2" Visibility="Collapsed"/></Grid>
   <ScrollViewer x:Name="ModelControlScroll" MaxHeight="214" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"><StackPanel x:Name="ModelControls" Spacing="8"/></ScrollViewer>
  </StackPanel>
  <Grid x:Name="Body" Grid.Row="2" ColumnSpacing="18" RowSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="ListColumn" Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition x:Name="ListRow" Height="*"/><RowDefinition x:Name="FormRow" Height="0"/></Grid.RowDefinitions>
   <ListView x:Name="RecordList" ItemTemplate="{StaticResource RecordTemplate}" SelectionMode="Single" SelectionChanged="RecordChanged" AutomationProperties.AutomationId="ManageList"/>
   <GridView x:Name="ModelCards" Visibility="Collapsed" ItemTemplate="{StaticResource ModelTemplate}" SelectionMode="Extended" IsMultiSelectCheckBoxEnabled="True" DoubleTapped="ModelCardDoubleTapped" KeyDown="ModelCardKeyDown" SelectionChanged="RecordChanged" ContainerContentChanging="ModelContainerChanging" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="ManageList" AutomationProperties.Name="模型">
    <GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/></Style></GridView.ItemContainerStyle>
    <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal"/></ItemsPanelTemplate></GridView.ItemsPanel>
   </GridView>
   <StackPanel x:Name="ModelEmpty" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Spacing="10" Visibility="Collapsed"><Viewbox Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"><ContentPresenter Content="Icon" ContentTemplate="{StaticResource LumaIconModel}" Style="{StaticResource LumaLineIcon}" Foreground="{ThemeResource LumaSecondary}"/></Viewbox><TextBlock x:Name="ModelEmptyTitle" Style="{StaticResource LumaHeading}" TextAlignment="Center" TextWrapping="Wrap" AutomationProperties.AutomationId="ManageModelEmpty"/><TextBlock x:Name="ModelEmptyNote" Style="{StaticResource LumaCaption}" TextAlignment="Center" TextWrapping="Wrap"/></StackPanel>
   <ScrollViewer x:Name="FormScroll" Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="ManageFormScroll"><StackPanel x:Name="Form" Spacing="12"/></ScrollViewer>
  </Grid>
  <StackPanel x:Name="StatusHost" Grid.Row="3" Spacing="6" Margin="0,8,0,0" Visibility="Collapsed"><TextBlock x:Name="Status" TextWrapping="Wrap" Style="{StaticResource LumaBody}" AutomationProperties.AutomationId="ManageStatus"/><Button x:Name="Resolve" Content="核对上次操作状态" Click="ResolveClicked" Style="{StaticResource LumaButton}" AutomationProperties.AutomationId="ManageResolve" Visibility="Collapsed"/></StackPanel>
 </Grid>
</UserControl>
