<UserControl x:Class="Luma.Preview.Views.FilesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="using:Luma.Preview.Views.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid RowSpacing="10">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <controls:TagChipPanel x:Name="Modes"/>
  <Grid x:Name="Body" Grid.Row="1" ColumnSpacing="16">
   <Grid.RowDefinitions><RowDefinition x:Name="SetupRow" Height="*"/><RowDefinition x:Name="ResultsRow" Height="0"/></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="SetupColumn" Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid x:Name="SetupPane" RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer x:Name="SetupScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="FilesSetupScroll"><StackPanel x:Name="Setup" Spacing="10" Padding="0,0,8,16"/></ScrollViewer><controls:TagChipPanel x:Name="RuleActions" Grid.Row="1" Visibility="Collapsed"/></Grid>
   <Grid x:Name="PreviewPane" Grid.Column="1" RowSpacing="8">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ReviewTitle" Text="文件预览" Style="{StaticResource LumaBody}" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel x:Name="RulesPager" Grid.Column="1" Orientation="Horizontal" Spacing="8" Visibility="Collapsed"/></Grid>
    <TextBlock x:Name="Summary" Grid.Row="1" TextWrapping="Wrap" Style="{StaticResource LumaCaption}" AutomationProperties.AutomationId="FilesSummary"/>
    <controls:TagChipPanel x:Name="PageActions" Grid.Row="2"/>
    <ListView x:Name="Entries" Grid.Row="3" SelectionMode="Single" SelectionChanged="EntrySelected" AutomationProperties.AutomationId="FilesEntries" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="Wrap" ToolTipService.ToolTip="{Binding Label}" FontSize="{Binding FontSize}" Margin="4,10"/></DataTemplate></ListView.ItemTemplate></ListView>
    <ListView x:Name="RulesList" Grid.Row="3" Visibility="Collapsed" SelectionMode="Single" SelectionChanged="RuleSelected" AutomationProperties.AutomationId="FilesRules" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="{Binding FontSize}" Margin="8,12"/></DataTemplate></ListView.ItemTemplate></ListView>
    <TextBlock x:Name="RulesEmpty" Grid.Row="3" Text="暂无规则" Style="{StaticResource LumaCaption}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
    <TextBox x:Name="Paths" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" Visibility="Collapsed" AutomationProperties.AutomationId="FilesFullPaths" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
   </Grid>
  </Grid>
  <StackPanel Grid.Row="2" Spacing="6">
   <controls:TagChipPanel x:Name="Actions"/>
  </StackPanel>
  <StackPanel Grid.Row="3" Spacing="4"><TextBlock x:Name="Status" TextWrapping="Wrap" Style="{StaticResource LumaBody}" AutomationProperties.AutomationId="FilesStatus"/><Button x:Name="Resolve" Content="核对上次操作状态" Click="ResolveClicked" Style="{StaticResource LumaButton}" Visibility="Collapsed" AutomationProperties.AutomationId="FilesResolve"/></StackPanel>
 </Grid>
</UserControl>
