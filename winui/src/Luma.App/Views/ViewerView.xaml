<UserControl x:Class="Luma.Preview.Views.ViewerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Luma.Preview.Views.Controls" xmlns:fx="using:Luma.Preview.Services" IsTabStop="True" AutomationProperties.AutomationId="ViewerSurface" AutomationProperties.Name="图片浏览，方向键切图，F11全屏，Esc返回">
 <Grid x:Name="ViewerRoot" Background="{ThemeResource LumaViewerShell}">
  <Grid.RowDefinitions><RowDefinition x:Name="ViewerHeaderRow" Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border x:Name="ImmersiveBackdrop" Grid.RowSpan="2" Background="Black" Visibility="Collapsed" IsHitTestVisible="False"/>
  <Grid x:Name="Body" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition x:Name="StageColumn" Width="*"/><ColumnDefinition x:Name="InfoColumn" Width="0"/></Grid.ColumnDefinitions>
   <Grid x:Name="StageContainer">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="ViewerToolsRow" Height="Auto"/></Grid.RowDefinitions>
   <Border x:Name="StageMatte" Background="{ThemeResource LumaViewerMatte}" IsHitTestVisible="False"/>
   <Grid x:Name="Stage" Background="Transparent" SizeChanged="StageResized" PointerWheelChanged="Wheel" PointerPressed="Pressed" PointerMoved="Moved" PointerReleased="Released" PointerCanceled="Released" PointerCaptureLost="Released" DoubleTapped="StageDoubleTapped" ManipulationMode="Scale,TranslateX,TranslateY" ManipulationDelta="Manipulated" AutomationProperties.AutomationId="ViewerStage" AutomationProperties.Name="图片舞台，滚轮缩放，拖动平移，双击适应或100%">
    <Canvas x:Name="Pixels" IsHitTestVisible="False"><Image x:Name="Picture" Stretch="Fill" RenderTransformOrigin="0.5,0.5"><Image.RenderTransform><CompositeTransform x:Name="Transform"/></Image.RenderTransform></Image></Canvas>
    <Border x:Name="LoadingBadge" Background="#D9151719" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="6"><StackPanel Spacing="10"><ProgressRing x:Name="Progress" Width="26" Height="26" Foreground="White"/><TextBlock x:Name="StageMessage" Foreground="White" TextWrapping="Wrap" MaxWidth="330" HorizontalAlignment="Center"/><Button x:Name="RetryButton" Content="重新加载" Click="RetryClicked" Style="{StaticResource LumaButton}" AutomationProperties.AutomationId="ViewerRetry"/></StackPanel></Border>
   </Grid>

    <Grid x:Name="BottomChrome" Grid.Row="1" Margin="12,0,12,6" VerticalAlignment="Bottom" RowSpacing="0">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border x:Name="ToolDock" Style="{StaticResource LumaGlassDock}" fx:GlassSurfaceEffects.Receiver="{Binding ElementName=Stage}" Grid.Row="1" Padding="4" HorizontalAlignment="Center" VerticalAlignment="Bottom">
      <StackPanel Spacing="2">
       <StackPanel x:Name="MediaPager" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed" Spacing="4"><Button x:Name="PreviousFrame" Click="PreviousFrameClicked" Style="{StaticResource LumaGlassGroupIcon}" AutomationProperties.AutomationId="ViewerPreviousFrame" AutomationProperties.Name="上一页或帧 (PageUp)" ToolTipService.ToolTip="上一页或帧 (PageUp)"><ContentPresenter Content="Icon" ContentTemplate="{StaticResource LumaIconUp}" Style="{StaticResource LumaLineIcon}"/></Button><TextBlock x:Name="MediaCounter" MinWidth="80" VerticalAlignment="Center" TextAlignment="Center" Style="{StaticResource LumaCaption}"/><Button x:Name="NextFrame" Click="NextFrameClicked" Style="{StaticResource LumaGlassGroupIcon}" AutomationProperties.AutomationId="ViewerNextFrame" AutomationProperties.Name="下一页或帧 (PageDown)" ToolTipService.ToolTip="下一页或帧 (PageDown)"><ContentPresenter Content="Icon" ContentTemplate="{StaticResource LumaIconDown}" Style="{StaticResource LumaLineIcon}"/></Button></StackPanel>
       <Grid ColumnSpacing="6" RowSpacing="2">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel x:Name="DockTools" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="2"><Button x:Name="ZoomOut" Click="ZoomOutClicked" Style="{StaticResource LumaGlassGroupIcon}" AutomationProperties.AutomationId="ViewerZoomOut" AutomationProperties.Name="缩小" ToolTipService.ToolTip="缩小" ><ContentPresenter Content="Icon" ContentTemplate="{StaticResource LumaIconMinus}" Style="{StaticResource LumaLineIcon}"/></Button><TextBlock x:Name="ZoomText" Width="58" VerticalAlignment="Center" TextAlignment="Center" Style="{StaticResource LumaCaption}"/><Button x:Name="ZoomIn" Click="ZoomInClicked" Style="{StaticResource LumaGlassGroupIcon}" AutomationProperties.AutomationId="ViewerZoomIn" AutomationProperties.Name="放大" ToolTipService.ToolTip="放大" ><ContentPresenter Content="Icon" ContentTemplate="{StaticResource LumaIconPlus}" Style="{StaticResource LumaLineIcon}"/></Button><Button x:Name="FitButton" Margin="5,0,0,0" Click="FitClicked" Style="{StaticResource LumaGlassGroupIcon}" AutomationProperties.AutomationId="ViewerFit" AutomationProperties.Name="适应窗口 (0)" ToolTipService.ToolTip="适应窗口 (0)" ><ContentPresenter Content="Icon" ContentTemplate="{StaticResource LumaIconFit}" Style="{StaticResource LumaLineIcon}"/></Button><Button x:Name="ActualButton" Click="ActualClicked" Style="{StaticResource LumaGlassGroupIcon}" AutomationProperties.AutomationId="ViewerActual" AutomationProperties.Name="原始像素 (1)" ToolTipService.ToolTip="原始像素 (1)" ><ContentPresenter Content="Icon" ContentTemplate="{StaticResource LumaIconActual}" Style="{StaticResource LumaLineIcon}"/></Button><Button x:Name="Rotate" Click="RotateClicked" Style="{StaticResource LumaGlassGroupIcon}" AutomationProperties.AutomationId="ViewerRotate" AutomationProperties.Name="旋转" ToolTipService.ToolTip="旋转" ><ContentPresenter Content="Icon" ContentTemplate="{StaticResource LumaIconRotate}" Style="{StaticResource LumaLineIcon}"/></Button><Button x:Name="FullButton" Click="FullClicked" Style="{StaticResource LumaGlassGroupIcon}" AutomationProperties.AutomationId="ViewerFullscreen" AutomationProperties.Name="全屏 (F11)" ToolTipService.ToolTip="全屏 (F11)" ><ContentPresenter Content="Icon" ContentTemplate="{StaticResource LumaIconFullscreen}" Style="{StaticResource LumaLineIcon}"/></Button></StackPanel>
        <StackPanel x:Name="DockOptions" Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
         <ComboBox x:Name="Sort" Width="146" HorizontalAlignment="Center" VerticalAlignment="Center" MinHeight="32" FontSize="12" SelectionChanged="SortChanged" AutomationProperties.AutomationId="ViewerSort" AutomationProperties.Name="当前范围的浏览顺序" ToolTipService.ToolTip="浏览顺序"/>
         <Grid x:Name="ReactionsHost" Padding="2,0" VerticalAlignment="Center"><controls:ImageReactions x:Name="Reactions" HorizontalAlignment="Center"/></Grid>
        </StackPanel>
       </Grid>
      </StackPanel>
     </Border>
     <Border x:Name="FilmstripSurface" Style="{StaticResource LumaGlassDock}" fx:GlassSurfaceEffects.Receiver="{Binding ElementName=Stage}" Padding="2" MaxWidth="860" Visibility="Collapsed">
  <ListView x:Name="Filmstrip" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="FilmClicked" ContainerContentChanging="FilmChanging" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" Height="80" Background="Transparent" Visibility="Collapsed" AutomationProperties.AutomationId="ViewerFilmstrip">
   <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel>
   <ListView.ItemTemplate><DataTemplate><Grid Width="80" Padding="2" RowSpacing="2"><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Image Source="{Binding Image}" Stretch="Uniform"/><TextBlock Visibility="Collapsed" Grid.Row="1" Text="{Binding Name}" FontSize="{Binding LabelSize}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource LumaText}"/></Grid></DataTemplate></ListView.ItemTemplate>
  </ListView>
     </Border>
    </Grid>

   </Grid>
   <Border x:Name="Info" Grid.Column="1" Style="{StaticResource LumaGlassDock}" fx:GlassSurfaceEffects.Receiver="{Binding ElementName=Stage}" Padding="16" VerticalAlignment="Top" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="ViewerInfoScroll"><StackPanel Spacing="12">
    <TextBlock x:Name="InfoTitle" Text="图片信息" Style="{StaticResource LumaBody}"/><TextBlock x:Name="ModelName" TextWrapping="Wrap" Visibility="Collapsed" Style="{StaticResource LumaCaption}"/>
    <TextBlock x:Name="MetadataError" Visibility="Collapsed" Text="生成信息读取失败，请重试。" TextWrapping="Wrap" Style="{StaticResource LumaBody}" AutomationProperties.AutomationId="ViewerMetadataError"/>
    <Button x:Name="RetryDetails" Visibility="Collapsed" Content="重试生成信息" Click="RetryDetailsClicked" Style="{StaticResource LumaButton}" AutomationProperties.AutomationId="ViewerRetryDetails"/>
    <controls:TagChipPanel x:Name="Tags" Visibility="Collapsed"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="PositiveLabel" Text="正面提示词" Style="{StaticResource LumaBody}" VerticalAlignment="Center"/><Button Grid.Column="1" x:Name="CopyPrompt" Click="CopyPromptClicked" Style="{StaticResource LumaGlassGroupIcon}" AutomationProperties.AutomationId="ViewerCopyPrompt" AutomationProperties.Name="复制正面提示词" Visibility="Collapsed" ToolTipService.ToolTip="复制正面提示词"><ContentPresenter Content="Icon" ContentTemplate="{StaticResource LumaIconCopy}" Style="{StaticResource LumaLineIcon}"/></Button></Grid>
    <ListView x:Name="Prompt" MaxHeight="170" Visibility="Collapsed" SelectionMode="None" AutomationProperties.AutomationId="ViewerPrompt"><ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel/></ItemsPanelTemplate></ListView.ItemsPanel><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" IsTextSelectionEnabled="True" TextWrapping="Wrap" Style="{StaticResource LumaBody}"/></DataTemplate></ListView.ItemTemplate></ListView>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="NegativeLabel" Text="负面提示词" Style="{StaticResource LumaBody}" VerticalAlignment="Center"/><Button Grid.Column="1" x:Name="CopyNegative" Click="CopyNegativeClicked" Style="{StaticResource LumaGlassGroupIcon}" AutomationProperties.AutomationId="ViewerCopyNegative" AutomationProperties.Name="复制负面提示词" Visibility="Collapsed" ToolTipService.ToolTip="复制负面提示词"><ContentPresenter Content="Icon" ContentTemplate="{StaticResource LumaIconCopy}" Style="{StaticResource LumaLineIcon}"/></Button></Grid>
    <ListView x:Name="Negative" MaxHeight="150" Visibility="Collapsed" SelectionMode="None" AutomationProperties.AutomationId="ViewerNegative"><ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel/></ItemsPanelTemplate></ListView.ItemsPanel><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" IsTextSelectionEnabled="True" TextWrapping="Wrap" Style="{StaticResource LumaBody}"/></DataTemplate></ListView.ItemTemplate></ListView>
   </StackPanel></ScrollViewer></Border>
  </Grid>
  <Grid x:Name="Header" Margin="12,10,12,0" VerticalAlignment="Top" ColumnSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Border x:Name="HeaderMetadata" Style="{StaticResource LumaGlassDock}" fx:GlassSurfaceEffects.Receiver="{Binding ElementName=Stage}" Padding="4" HorizontalAlignment="Left">
    <Grid ColumnSpacing="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Button x:Name="Back" Click="BackClicked" Style="{StaticResource LumaGlassGroupIcon}" AutomationProperties.AutomationId="ViewerBack" AutomationProperties.Name="返回图库" ToolTipService.ToolTip="返回图库" ><ContentPresenter Content="Icon" ContentTemplate="{StaticResource LumaIconBack}" Style="{StaticResource LumaLineIcon}"/></Button>
     <StackPanel Grid.Column="1" Margin="6,0,8,0" VerticalAlignment="Center" Orientation="Vertical" Spacing="0"><TextBlock x:Name="FileName" HorizontalAlignment="Left" Style="{StaticResource LumaBody}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="ImageNote" AutomationProperties.AutomationId="ViewerImageNote" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Style="{StaticResource LumaCaption}"/></StackPanel>
    </Grid>
   </Border>
   <Border x:Name="HeaderCommands" Grid.Column="1" Style="{StaticResource LumaGlassDock}" fx:GlassSurfaceEffects.Receiver="{Binding ElementName=Stage}" Padding="4" VerticalAlignment="Top">
    <StackPanel Orientation="Horizontal" Spacing="2"><Button x:Name="Previous" Click="PreviousClicked" Style="{StaticResource LumaGlassGroupIcon}" AutomationProperties.AutomationId="ViewerPrevious" AutomationProperties.Name="上一张 (←)" ToolTipService.ToolTip="上一张 (←)" ><ContentPresenter Content="Icon" ContentTemplate="{StaticResource LumaIconLeft}" Style="{StaticResource LumaLineIcon}"/></Button><Button x:Name="Next" Click="NextClicked" Style="{StaticResource LumaGlassGroupIcon}" AutomationProperties.AutomationId="ViewerNext" AutomationProperties.Name="下一张 (→)" ToolTipService.ToolTip="下一张 (→)" ><ContentPresenter Content="Icon" ContentTemplate="{StaticResource LumaIconRight}" Style="{StaticResource LumaLineIcon}"/></Button><Button x:Name="PlaybackButton" Click="PlaybackClicked" Style="{StaticResource LumaGlassGroupIcon}" AutomationProperties.AutomationId="ViewerPlayback" AutomationProperties.Name="自动播放 (空格)" ToolTipService.ToolTip="自动播放 (空格)"><ContentPresenter x:Name="PlaybackIcon" Content="Icon" ContentTemplate="{StaticResource LumaIconPlay}" Style="{StaticResource LumaLineIcon}"/></Button><Button x:Name="FilmToggle" Click="FilmToggleClicked" Style="{StaticResource LumaGlassGroupIcon}" AutomationProperties.AutomationId="ViewerFilmToggle" AutomationProperties.Name="缩略图" ToolTipService.ToolTip="缩略图" ><ContentPresenter Content="Icon" ContentTemplate="{StaticResource LumaIconFilmstrip}" Style="{StaticResource LumaLineIcon}"/></Button><Button x:Name="InfoToggle" Click="InfoClicked" Style="{StaticResource LumaGlassGroupIcon}" AutomationProperties.AutomationId="ViewerInfo" AutomationProperties.Name="图片信息 (I)" ToolTipService.ToolTip="图片信息 (I)" ><Grid Width="26" Height="30"><ContentPresenter Content="Icon" ContentTemplate="{StaticResource LumaIconInfo}" Style="{StaticResource LumaLineIcon}"/><Border x:Name="InfoActiveMark" Background="{ThemeResource LumaAccent}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Width="12" Height="2" CornerRadius="1" Visibility="Collapsed"/></Grid></Button></StackPanel>
   </Border>
  </Grid>
  <Border x:Name="FeedbackSurface" Grid.Row="1" Style="{StaticResource LumaGlassDock}" fx:GlassSurfaceEffects.Receiver="{Binding ElementName=Stage}" Visibility="Collapsed" Padding="12,6" MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Bottom" IsHitTestVisible="False" AutomationProperties.LiveSetting="Polite">
   <TextBlock x:Name="Feedback" TextWrapping="Wrap" Style="{StaticResource LumaCaption}" AutomationProperties.AutomationId="ViewerFeedback"/>
  </Border>
 </Grid>
</UserControl>
