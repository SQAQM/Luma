<UserControl x:Class="Luma.Preview.Views.ViewerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Luma.Preview.Views.Controls" IsTabStop="True" AutomationProperties.AutomationId="ViewerSurface" AutomationProperties.Name="图片浏览，方向键切图，F11全屏，Esc返回">
 <Grid x:Name="ViewerRoot" Background="Transparent">
  <Grid.RowDefinitions><RowDefinition x:Name="HeaderRow" Height="Auto"/><RowDefinition Height="*"/><RowDefinition x:Name="ReactionsRow" Height="Auto"/><RowDefinition x:Name="FilmRow" Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="Body" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition x:Name="StageColumn" Width="*"/><ColumnDefinition x:Name="InfoColumn" Width="0"/></Grid.ColumnDefinitions>
   <Grid x:Name="StageContainer">
   <Grid x:Name="Stage" Background="Transparent" SizeChanged="StageResized" PointerWheelChanged="Wheel" PointerPressed="Pressed" PointerMoved="Moved" PointerReleased="Released" PointerCanceled="Released" PointerCaptureLost="Released" DoubleTapped="StageDoubleTapped" ManipulationMode="Scale,TranslateX,TranslateY" ManipulationDelta="Manipulated" AutomationProperties.AutomationId="ViewerStage" AutomationProperties.Name="图片舞台，滚轮缩放，拖动平移，双击适应或100%">
    <Canvas x:Name="Pixels" IsHitTestVisible="False"><Image x:Name="Picture" Stretch="Fill" RenderTransformOrigin="0.5,0.5"><Image.RenderTransform><CompositeTransform x:Name="Transform"/></Image.RenderTransform></Image></Canvas>
    <Border x:Name="LoadingBadge" Background="#D9151719" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="6"><StackPanel Spacing="10"><ProgressRing x:Name="Progress" Width="26" Height="26" Foreground="White"/><TextBlock x:Name="StageMessage" Foreground="White" TextWrapping="Wrap" MaxWidth="330" HorizontalAlignment="Center"/><Button x:Name="RetryButton" Content="重新加载" Click="RetryClicked" Style="{StaticResource LumaButton}" AutomationProperties.AutomationId="ViewerRetry"/></StackPanel></Border>
   </Grid>

    <Border x:Name="ToolDock" Background="{ThemeResource LumaControlFill}" CornerRadius="10" Padding="6" Margin="8,0,8,12" HorizontalAlignment="Center" VerticalAlignment="Bottom"><StackPanel Orientation="Horizontal" Spacing="2"><Button x:Name="ZoomOut" Click="ZoomOutClicked" Style="{StaticResource LumaViewerIcon}" AutomationProperties.AutomationId="ViewerZoomOut" AutomationProperties.Name="缩小" ToolTipService.ToolTip="缩小" ><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE738;" FontSize="16"/></Button><TextBlock x:Name="ZoomText" Width="48" VerticalAlignment="Center" TextAlignment="Center" Style="{StaticResource LumaCaption}"/><Button x:Name="ZoomIn" Click="ZoomInClicked" Style="{StaticResource LumaViewerIcon}" AutomationProperties.AutomationId="ViewerZoomIn" AutomationProperties.Name="放大" ToolTipService.ToolTip="放大" ><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE710;" FontSize="16"/></Button><Button x:Name="FitButton" Click="FitClicked" Style="{StaticResource LumaViewerIcon}" AutomationProperties.AutomationId="ViewerFit" AutomationProperties.Name="适应窗口 (0)" ToolTipService.ToolTip="适应窗口 (0)" ><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE9A6;" FontSize="16"/></Button><Button x:Name="ActualButton" Click="ActualClicked" Style="{StaticResource LumaViewerIcon}" AutomationProperties.AutomationId="ViewerActual" AutomationProperties.Name="原始像素 (1)" ToolTipService.ToolTip="原始像素 (1)" ><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE799;" FontSize="16"/></Button><Button x:Name="Rotate" Click="RotateClicked" Style="{StaticResource LumaViewerIcon}" AutomationProperties.AutomationId="ViewerRotate" AutomationProperties.Name="旋转" ToolTipService.ToolTip="旋转" ><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7AD;" FontSize="16"/></Button><Button x:Name="FullButton" Click="FullClicked" Style="{StaticResource LumaViewerIcon}" AutomationProperties.AutomationId="ViewerFullscreen" AutomationProperties.Name="全屏 (F11)" ToolTipService.ToolTip="全屏 (F11)" ><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE740;" FontSize="16"/></Button><ComboBox x:Name="Sort" Width="140" MinHeight="32" FontSize="12" SelectionChanged="SortChanged" AutomationProperties.AutomationId="ViewerSort" AutomationProperties.Name="当前范围的浏览顺序" ToolTipService.ToolTip="浏览顺序"/></StackPanel></Border>
   </Grid>
   <Grid x:Name="Info" Grid.Column="1" Background="{ThemeResource LumaCanvas}" Padding="16" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="ViewerInfoScroll"><StackPanel Spacing="12">
    <TextBlock x:Name="InfoTitle" Text="图片信息" Style="{StaticResource LumaBody}"/><TextBlock x:Name="ModelName" TextWrapping="Wrap" Style="{StaticResource LumaCaption}"/>
    <TextBlock x:Name="MetadataError" Visibility="Collapsed" Text="生成信息读取失败，请重试。" TextWrapping="Wrap" Style="{StaticResource LumaBody}" AutomationProperties.AutomationId="ViewerMetadataError"/>
    <Button x:Name="RetryDetails" Visibility="Collapsed" Content="重试生成信息" Click="RetryDetailsClicked" Style="{StaticResource LumaButton}" AutomationProperties.AutomationId="ViewerRetryDetails"/>
    <controls:TagChipPanel x:Name="Tags"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="PositiveLabel" Text="正面提示词" Style="{StaticResource LumaBody}"/><Button Grid.Column="1" x:Name="CopyPrompt" Content="复制" Click="CopyPromptClicked" Style="{StaticResource LumaButton}" AutomationProperties.AutomationId="ViewerCopyPrompt"/></Grid>
    <ListView x:Name="Prompt" Height="170" SelectionMode="None" AutomationProperties.AutomationId="ViewerPrompt"><ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel/></ItemsPanelTemplate></ListView.ItemsPanel><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" IsTextSelectionEnabled="True" TextWrapping="Wrap" Style="{StaticResource LumaBody}"/></DataTemplate></ListView.ItemTemplate></ListView>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="NegativeLabel" Text="负面提示词" Style="{StaticResource LumaBody}"/><Button Grid.Column="1" x:Name="CopyNegative" Content="复制" Click="CopyNegativeClicked" Style="{StaticResource LumaButton}" AutomationProperties.AutomationId="ViewerCopyNegative"/></Grid>
    <ListView x:Name="Negative" Height="120" SelectionMode="None" AutomationProperties.AutomationId="ViewerNegative"><ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel/></ItemsPanelTemplate></ListView.ItemsPanel><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" IsTextSelectionEnabled="True" TextWrapping="Wrap" Style="{StaticResource LumaBody}"/></DataTemplate></ListView.ItemTemplate></ListView>
    <controls:TagChipPanel><Button x:Name="OpenOriginal" Content="打开原图" Tag="open" Click="FileClicked" Style="{StaticResource LumaButton}" AutomationProperties.AutomationId="ViewerOpenOriginal"/><Button x:Name="CopyPath" Content="复制路径" Tag="copy" Click="FileClicked" Style="{StaticResource LumaButton}" AutomationProperties.AutomationId="ViewerCopyPath"/></controls:TagChipPanel>
   </StackPanel></ScrollViewer></Grid>

  </Grid>
  <ListView Grid.Row="3" x:Name="Filmstrip" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="FilmClicked" ContainerContentChanging="FilmChanging" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" Height="80" Visibility="Collapsed" AutomationProperties.AutomationId="ViewerFilmstrip">
   <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel>
   <ListView.ItemTemplate><DataTemplate><Grid Width="80" Padding="2" RowSpacing="2"><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Image Source="{Binding Image}" Stretch="Uniform"/><TextBlock Visibility="Collapsed" Grid.Row="1" Text="{Binding Name}" FontSize="{Binding LabelSize}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource LumaText}"/></Grid></DataTemplate></ListView.ItemTemplate>
  </ListView>

  <Grid x:Name="ReactionsHost" Grid.Row="2" Padding="8,2,8,4"><controls:ImageReactions x:Name="Reactions" HorizontalAlignment="Center"/></Grid>

  <Grid x:Name="Header" MinHeight="44" Padding="10,4" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border x:Name="HeaderBackdrop" Grid.ColumnSpan="3" Background="{ThemeResource LumaControlFill}" Margin="-10,-4" Visibility="Collapsed" IsHitTestVisible="False"/>
   <Button x:Name="Back" Click="BackClicked" Style="{StaticResource LumaViewerIcon}" AutomationProperties.AutomationId="ViewerBack" AutomationProperties.Name="返回图库" ToolTipService.ToolTip="返回图库" ><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72B;" FontSize="16"/></Button>
   <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Vertical" Spacing="0"><TextBlock x:Name="FileName" HorizontalAlignment="Left" MaxWidth="360" Style="{StaticResource LumaBody}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="ImageNote" AutomationProperties.AutomationId="ViewerImageNote" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Style="{StaticResource LumaCaption}"/></StackPanel>
   <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"><Button x:Name="Previous" Click="PreviousClicked" Style="{StaticResource LumaViewerIcon}" AutomationProperties.AutomationId="ViewerPrevious" AutomationProperties.Name="上一张 (←)" ToolTipService.ToolTip="上一张 (←)" ><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE76B;" FontSize="16"/></Button><Button x:Name="Next" Click="NextClicked" Style="{StaticResource LumaViewerIcon}" AutomationProperties.AutomationId="ViewerNext" AutomationProperties.Name="下一张 (→)" ToolTipService.ToolTip="下一张 (→)" ><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE76C;" FontSize="16"/></Button><Button x:Name="FilmToggle" Click="FilmToggleClicked" Style="{StaticResource LumaViewerIcon}" AutomationProperties.AutomationId="ViewerFilmToggle" AutomationProperties.Name="缩略图" ToolTipService.ToolTip="缩略图" ><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8B9;" FontSize="16"/></Button><Button x:Name="InfoToggle" Click="InfoClicked" Style="{StaticResource LumaViewerIcon}" AutomationProperties.AutomationId="ViewerInfo" AutomationProperties.Name="图片信息 (I)" ToolTipService.ToolTip="图片信息 (I)" ><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE946;" FontSize="16"/></Button></StackPanel>
  </Grid>
    <TextBlock x:Name="Feedback" Grid.Row="1" Margin="16,8,16,66" MaxWidth="500" HorizontalAlignment="Left" VerticalAlignment="Bottom" Style="{StaticResource LumaCaption}" TextWrapping="Wrap" IsHitTestVisible="False" AutomationProperties.AutomationId="ViewerFeedback"/>
 </Grid>
</UserControl>
