<UserControl x:Class="Luma.Preview.Views.ShellView" xmlns:views="using:Luma.Preview.Views" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid x:Name="ShellRoot" Background="Transparent">
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="RailColumn" Width="148"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition x:Name="TopRow" Height="0"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border x:Name="Rail" Grid.Row="1" Background="Transparent" BorderThickness="0">
   <Grid x:Name="RailHost"><Border x:Name="RailTint" Background="{ThemeResource LumaSidebar}" IsHitTestVisible="False"/><Grid x:Name="RailContent" RowSpacing="16" Padding="16"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer x:Name="NavigationScroll" Grid.Row="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Navigation" Spacing="4"/></ScrollViewer>
    <StackPanel x:Name="Preferences" Grid.Row="1" Spacing="12">
     <TextBlock Text="外观" Style="{StaticResource LumaHeading}" FontSize="20"/>
     <StackPanel Orientation="Horizontal" Spacing="4"><Button Width="86" MinWidth="0" Padding="10,6" x:Name="LightButton" Content="浅色" Tag="Light" Click="ThemeClicked" Style="{StaticResource LumaButton}" AutomationProperties.AutomationId="ThemeLight" AutomationProperties.Name="浅色主题" ToolTipService.ToolTip="浅色主题"/><Button Width="86" MinWidth="0" Padding="10,6" x:Name="DarkButton" Content="深色" Tag="Dark" Click="ThemeClicked" Style="{StaticResource LumaButton}" AutomationProperties.AutomationId="ThemeDark" AutomationProperties.Name="深色主题" ToolTipService.ToolTip="深色主题"/><Button Width="104" MinWidth="0" Padding="10,6" x:Name="SystemButton" Content="跟随系统" Tag="System" Click="ThemeClicked" Style="{StaticResource LumaButton}" AutomationProperties.AutomationId="ThemeSystem" AutomationProperties.Name="跟随系统主题" ToolTipService.ToolTip="跟随系统主题"/></StackPanel>
     <Button x:Name="MaterialButton" Content="透明玻璃" HorizontalAlignment="Left" Click="MaterialClicked" Style="{StaticResource LumaButton}" AutomationProperties.AutomationId="MaterialToggle" AutomationProperties.Name="透明材质" ToolTipService.ToolTip="透明材质"/><CheckBox x:Name="ReduceMotion" Content="减少动态" Checked="MotionChanged" Unchecked="MotionChanged" AutomationProperties.AutomationId="ReduceMotion"/>
    </StackPanel><Grid x:Name="FooterActions" Grid.Row="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel x:Name="SettingsNavigation"/><Button Grid.Column="1" Width="32" MinWidth="0" Padding="0" Click="OpenImageClicked" Style="{StaticResource LumaButton}" AutomationProperties.AutomationId="OpenImage" AutomationProperties.Name="打开图片 (Ctrl+O)" ToolTipService.ToolTip="打开图片 (Ctrl+O)"><FontIcon Glyph="&#xE8E5;" FontSize="16"/></Button></Grid>
   </Grid></Grid>
  </Border>
  <Grid x:Name="Workspace" Grid.Column="1" Grid.Row="1" Padding="24" RowSpacing="16" Background="{ThemeResource LumaCanvas}">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Spacing="4"><TextBlock x:Name="ScopeNote" Text="本机图片与模型" Style="{StaticResource LumaCaption}"/><TextBlock x:Name="PageTitle" Style="{StaticResource LumaHeading}" AutomationProperties.AutomationId="PageTitle"/></StackPanel>
   </Grid>
   <Grid x:Name="PageBody" Grid.Row="1">
    <views:GalleryView x:Name="LiveGallery" Visibility="Collapsed"/>
    <views:ManagementView x:Name="Management" Visibility="Collapsed"/>
    <views:FilesView x:Name="Files" Visibility="Collapsed"/>
    <StackPanel x:Name="StatePanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480" Spacing="16"><FontIcon x:Name="StateIcon" Glyph="&#xE8B7;" FontSize="40" Foreground="{ThemeResource LumaAccent}"/><StackPanel x:Name="WelcomeActions" Spacing="8" HorizontalAlignment="Center"/><ProgressRing x:Name="LoadingRing" Width="32" Height="32" IsActive="False"/><TextBlock x:Name="StateTitle" Style="{StaticResource LumaHeading}" FontSize="22" TextAlignment="Center"/><TextBlock x:Name="StateDescription" Visibility="Collapsed" Style="{StaticResource LumaBody}" TextAlignment="Center"/><Button x:Name="StateAction" HorizontalAlignment="Center" Click="StateActionClicked" Style="{StaticResource LumaButton}" AutomationProperties.AutomationId="StateAction"/></StackPanel>
   </Grid>
   <Grid x:Name="Footer" Grid.Row="2" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Feedback" VerticalAlignment="Center" Style="{StaticResource LumaCaption}" AutomationProperties.AutomationId="Feedback"/></Grid>
  </Grid>
 </Grid>
</UserControl>
