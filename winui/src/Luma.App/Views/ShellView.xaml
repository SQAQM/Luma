<UserControl x:Class="Luma.Preview.Views.ShellView" xmlns:views="using:Luma.Preview.Views" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid x:Name="ShellRoot" Background="Transparent">
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="RailColumn" Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition x:Name="TopRow" Height="0"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border x:Name="Rail" Grid.Row="1" Background="Transparent">
   <Grid x:Name="RailHost"><Border x:Name="RailTint" Background="{ThemeResource LumaSidebar}" IsHitTestVisible="False"/><Grid x:Name="RailContent" RowSpacing="14" Padding="10"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer x:Name="NavigationScroll" Grid.Row="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Navigation" HorizontalAlignment="Center" Spacing="5"/></ScrollViewer>
    <StackPanel x:Name="Preferences" Grid.Row="1" Spacing="12">
     <TextBlock Text="外观" Style="{StaticResource LumaHeading}" FontSize="20"/>
     <StackPanel Orientation="Horizontal" Spacing="4"><Button Width="86" MinWidth="0" Padding="10,6" x:Name="LightButton" Content="浅色" Tag="Light" Click="ThemeClicked" Style="{StaticResource LumaButton}" AutomationProperties.AutomationId="ThemeLight" AutomationProperties.Name="浅色主题" ToolTipService.ToolTip="浅色主题"/><Button Width="86" MinWidth="0" Padding="10,6" x:Name="DarkButton" Content="深色" Tag="Dark" Click="ThemeClicked" Style="{StaticResource LumaButton}" AutomationProperties.AutomationId="ThemeDark" AutomationProperties.Name="深色主题" ToolTipService.ToolTip="深色主题"/><Button Width="104" MinWidth="0" Padding="10,6" x:Name="SystemButton" Content="跟随系统" Tag="System" Click="ThemeClicked" Style="{StaticResource LumaButton}" AutomationProperties.AutomationId="ThemeSystem" AutomationProperties.Name="跟随系统主题" ToolTipService.ToolTip="跟随系统主题"/></StackPanel>
     <StackPanel Spacing="5">
      <TextBlock Text="文字颜色" Style="{StaticResource LumaBody}"/>
      <StackPanel Orientation="Horizontal" Spacing="6">
       <Button Style="{StaticResource LumaButton}" AutomationProperties.AutomationId="AppearanceTextColor" AutomationProperties.Name="选择文字颜色">
        <StackPanel Orientation="Horizontal" Spacing="8">
         <Border x:Name="TextSwatch" Width="16" Height="16" CornerRadius="4" BorderThickness="0.5" BorderBrush="{ThemeResource LumaStroke}"/>
         <TextBlock x:Name="TextColorLabel" Text="主题默认" VerticalAlignment="Center"/>
        </StackPanel>
        <Button.Flyout>
         <Flyout Placement="Bottom"><ColorPicker x:Name="TextColorPicker" AutomationProperties.Name="文字颜色" IsHexInputVisible="True" IsAlphaEnabled="False" ColorChanged="TextColorChanged"/></Flyout>
        </Button.Flyout>
       </Button>
       <Button x:Name="ResetTextColor" Content="恢复默认" Style="{StaticResource LumaButton}" Click="ResetTextColorClicked" AutomationProperties.AutomationId="AppearanceResetTextColor"/>
      </StackPanel>
     </StackPanel>
     <ComboBox x:Name="MaterialPicker" Header="背景" MinWidth="0" HorizontalAlignment="Stretch" SelectionChanged="MaterialChanged" AutomationProperties.AutomationId="BackgroundMaterial" AutomationProperties.Name="背景">
      <ComboBoxItem Content="亚克力"/>
      <ComboBoxItem Content="磨砂玻璃"/>
      <ComboBoxItem Content="液态玻璃"/>
      <ComboBoxItem Content="实色"/>
      <ComboBoxItem Content="自定义颜色"/>
      <ComboBoxItem Content="自定义图片"/>
     </ComboBox>
     <Button x:Name="BackgroundColorButton" Visibility="Collapsed" HorizontalAlignment="Left" Style="{StaticResource LumaButton}" AutomationProperties.AutomationId="AppearanceBackgroundColor" AutomationProperties.Name="选择背景颜色">
      <StackPanel Orientation="Horizontal" Spacing="8">
       <Border x:Name="BackgroundSwatch" Width="16" Height="16" CornerRadius="4" BorderThickness="0.5" BorderBrush="{ThemeResource LumaStroke}"/>
       <TextBlock x:Name="BackgroundColorLabel" Text="选择颜色" VerticalAlignment="Center"/>
      </StackPanel>
      <Button.Flyout>
       <Flyout Placement="Bottom"><ColorPicker x:Name="BackgroundColorPicker" AutomationProperties.Name="背景颜色" IsHexInputVisible="True" IsAlphaEnabled="False" ColorChanged="BackgroundColorChanged"/></Flyout>
      </Button.Flyout>
     </Button>
     <Button x:Name="WallpaperButton" Content="选择图片" Visibility="Collapsed" HorizontalAlignment="Left" MaxWidth="380" Style="{StaticResource LumaButton}" Click="PickWallpaperClicked" AutomationProperties.AutomationId="AppearanceWallpaper" AutomationProperties.Name="选择背景图片"/>
     <Slider x:Name="TransparencySlider" Header="背景透明度 85%" Minimum="0" Maximum="100" Value="85" StepFrequency="1" SnapsTo="StepValues" Width="248" HorizontalAlignment="Left" Foreground="{ThemeResource LumaAccent}" ValueChanged="TransparencyChanged" AutomationProperties.AutomationId="BackgroundTransparency" AutomationProperties.Name="背景透明度"/>
     <CheckBox x:Name="ReduceMotion" Content="减少动态" Checked="MotionChanged" Unchecked="MotionChanged" AutomationProperties.AutomationId="ReduceMotion"/>
    </StackPanel><StackPanel x:Name="SettingsNavigation" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
   </Grid></Grid>
  </Border>
  <Grid x:Name="Workspace" Grid.Column="1" Grid.Row="1" Padding="24" RowSpacing="16" Background="{ThemeResource LumaWorkspace}">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Spacing="4"><TextBlock x:Name="ScopeNote" Text="本机图片与模型" Style="{StaticResource LumaCaption}"/><TextBlock x:Name="PageTitle" Style="{StaticResource LumaHeading}" AutomationProperties.AutomationId="PageTitle"/></StackPanel>
   </Grid>
   <Grid x:Name="PageBody" Grid.Row="1">
    <views:GalleryView x:Name="LiveGallery" Visibility="Collapsed"/>
    <views:ManagementView x:Name="Management" Visibility="Collapsed"/>
    <views:FilesView x:Name="Files" Visibility="Collapsed"/>
    <StackPanel x:Name="StatePanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480" Spacing="16"><Viewbox x:Name="StateIcon" Width="46" Height="46" HorizontalAlignment="Center" VerticalAlignment="Center"><ContentPresenter x:Name="StateGlyph" Content="Icon" ContentTemplate="{StaticResource LumaIconGalleryStack}" Style="{StaticResource LumaLineIcon}" Foreground="{ThemeResource LumaAccent}"/></Viewbox><StackPanel x:Name="WelcomeActions" Spacing="8" HorizontalAlignment="Center"/><ProgressRing x:Name="LoadingRing" Width="32" Height="32" IsActive="False"/><TextBlock x:Name="StateTitle" Style="{StaticResource LumaHeading}" FontSize="22" TextAlignment="Center"/><TextBlock x:Name="StateDescription" Visibility="Collapsed" Style="{StaticResource LumaBody}" TextAlignment="Center"/><Button x:Name="StateAction" HorizontalAlignment="Center" Click="StateActionClicked" Style="{StaticResource LumaButton}" AutomationProperties.AutomationId="StateAction"/></StackPanel>
   </Grid>
   <Grid x:Name="Footer" Grid.Row="2" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Feedback" VerticalAlignment="Center" Style="{StaticResource LumaCaption}" AutomationProperties.AutomationId="Feedback"/></Grid>
  </Grid>
 </Grid>
</UserControl>
