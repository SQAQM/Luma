<Window x:Class="Luma.Preview.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:Luma.Preview.Views">
 <Grid x:Name="Surface" Background="Transparent" Loaded="SurfaceLoaded" SizeChanged="SurfaceSizeChanged">
  <Grid.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/Colors.xaml"/><ResourceDictionary Source="Themes/SelectionColors.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border x:Name="WindowTint" Grid.RowSpan="2" Background="{ThemeResource LumaCanvas}" IsHitTestVisible="False"/>
  <Grid x:Name="ChromeArea" Background="Transparent">
   <Border x:Name="ChromeTint" Background="{ThemeResource LumaCanvas}" IsHitTestVisible="False"/>
   <TitleBar x:Name="Chrome" Title="Luma" Foreground="{ThemeResource LumaText}" Background="Transparent" AutomationProperties.AutomationId="LumaTitleBar">
    <TitleBar.IconSource><FontIconSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE91B;" Foreground="{ThemeResource LumaAccent}"/></TitleBar.IconSource>
   </TitleBar>
  </Grid>
  <Grid x:Name="ContentHost" Grid.Row="1"/>
 </Grid>
</Window>
